# Local development uses SQLite by default. Set DATABASE_URL for PostgreSQL in deployment.
DATABASE_URL=sqlite:///./eratrip.db

# Replace this with a random value before deployment.
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional integrations. Keep real credentials out of Git.
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_NAME=EraTrip
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_THINKING_TIME_MIN=30
AI_THINKING_TIME_MAX=60
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
